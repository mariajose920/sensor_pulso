# Conexión a Supabase (proyecto sensor_pulso). Copiar a .env.local, que NO se sube a git.
# La URL y la clave publicable son públicas por diseño (van en el navegador); la seguridad la da el RLS.
VITE_SUPABASE_URL=https://ozzehtpqxpicfqvmulcg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CD_KR_pwQQQ1e_HR2aQemw_mNjM2_ml

# SOLO servidor (funciones API, recepción del ESP32, cifrado de campos). Nunca con prefijo VITE_
# (Vite expone al navegador todo lo que empieza con VITE_) ni en el repositorio.
# Se configuran como variables de entorno en Vercel.
SUPABASE_SECRET_KEY=
# Clave del cifrado de la ficha de salud (RF116). OBLIGATORIA, mínimo 16 caracteres y aleatoria
# (p. ej. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Sin ella el servidor se niega a cifrar y descifrar (no hay clave por defecto). Guarda una copia en custodia:
# sin esta clave la ficha de salud no se puede recuperar. Para rotar: nueva clave en SALUD_ENCRYPTION_KEY_V2 y CLAVE_VERSION_ACTIVA=2.
CLAVE_CIFRADO_CAMPOS=
CLAVE_VERSION_ACTIVA=1

# RF100: Servicio de envío de correos institucional mediante Resend
RESEND_API_KEY=re_tu_clave_de_resend_aqui

# RF88: correo institucional (@unach.cl) que atiende las solicitudes de privacidad. Es público (se muestra en /privacidad).
VITE_CONTACTO_PRIVACIDAD=
